{
  "name": "composable-reviews",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Review a set of inter-related pull requests as a graph of optional capabilities.",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "core",
    "builder",
    "viewer"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint core builder viewer eslint.config.js",
    "test": "npm run test --workspaces",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
